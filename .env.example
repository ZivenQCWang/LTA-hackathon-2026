# SQLite works out of the box and persists crew, plans and forecasts under storage/.
# Public reports can sync to DBStudios; planner data and photo bytes stay in SQLite.
DATABASE_URL=sqlite:///./storage/nightshift.db
# Use the NightShift AI project API URL and a server-only read/write key.
# See docs/DBSTUDIOS_REPORTS.md. Leave both blank for local-only reporting.
DBSTUDIOS_API_URL=
DBSTUDIOS_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Local development has no login. See docs/DEPLOYMENT.md for HTTPS hosting.
PLIZ_ENV=development
# Set true ONLY for an intentionally public, shared, synthetic-data demo.
PLIZ_PUBLIC_DEMO=false
# Private production deployments need these. Public demo mode opens reports and photos without a login.
# Use a password of at least 16 characters.
PLIZ_AUTH_USERNAME=
PLIZ_AUTH_PASSWORD=
PLIZ_ALLOWED_ORIGINS=
PLIZ_PUBLIC_READONLY=false
PLIZ_AI_REQUESTS_PER_MINUTE=8
PLIZ_AI_REQUESTS_PER_DAY=200
